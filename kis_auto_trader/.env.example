# 이 파일을 복사해서 ".env" 로 이름을 바꾸고 실제 값을 채우세요.
# .env 파일은 .gitignore 에 들어있어 커밋되지 않습니다. 절대 남에게 공유하지 마세요.

# 한국투자증권 개발자센터(https://apiportal.koreainvestment.com)에서 발급받은 키
# 모의투자용과 실전투자용은 서로 다른 키입니다. 둘 다 발급받아 아래에 채우세요.

KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=       # 모의투자 계좌번호 (예: 12345678-01)

KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=       # 실전투자 계좌번호 (예: 12345678-01)

# screener.py --mode news (뉴스 호재/악재 판단) 에만 필요.
# console.anthropic.com 에서 발급받으세요. 종목당 1회 호출이라 비용은 매우 작습니다.
ANTHROPIC_API_KEY=
